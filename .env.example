# Copy this file to .env and paste your key. Get one at https://console.groq.com/keys
# Never commit, share or paste the real .env anywhere.
GROQ_API_KEY=gsk_your_key_here

# Optional: default model (any chat model your key can use)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: shareable portfolio links on GitHub Pages (README, "Portfolio links")
# PORTFOLIO_GITHUB_TOKEN=github_pat_...   fine-grained, Contents: Read and write on this one repo only
# PORTFOLIO_REPO=H2hofficially/portfolio
# PORTFOLIO_BASE_URL=                      only for a custom domain
